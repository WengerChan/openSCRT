<?xml version="1.0" encoding="UTF-8"?>
<!--
  openSCRT Windows installer.

  Two things this file deliberately does NOT do:

  1. It does not list files. The payload is harvested from the staged tree by heat
     (.github/workflows/release.yml), because windeployqt's output changes with the Qt version:
     a hand-maintained <File> list would silently drop Qt6Core.dll from the MSI and the installer
     would install something that cannot start on a machine without Qt installed.
  2. It does not hardcode a version. ProductVersion is passed in with -dProductVersion after the
     tag has been checked against VERSION in CMakeLists.txt.

  Only behaviour that cannot be harvested lives here: install scope, upgrade identity, and
  putting %ProgramFiles%\openSCRT\bin on PATH so the openscrt command works from any shell.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <!-- Manufacturer and UpgradeCode are literals on purpose: UpgradeCode must stay byte-identical
       for every release ever, and the only value that has to change per build (ProductVersion)
       arrives through candle's -dProductVersion. -->
  <Product Id="*"
           Name="openSCRT"
           Language="1033"
           Version="$(var.ProductVersion)"
           Manufacturer="openSCRT"
           UpgradeCode="{6F4A1E52-9C1B-4C7A-9F2D-8B6C0D5E7A31}">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Description="openSCRT $(var.ProductVersion), a SecureCRT-alike terminal emulator" />

    <!-- UpgradeCode is the identity that ties v0.1.0 to v0.2.0. Without a stable one every
         release installs side by side and the user ends up with two copies on PATH. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of openSCRT is already installed. Uninstall it before installing this build." />

    <MediaTemplate EmbedCab="yes" />

    <UIRef Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <!-- Without this, Add/Remove Programs shows a product with a blank "Installed on". -->
    <Property Id="ARPINSTALLLOCATION" Value="INSTALLFOLDER" />

    <Feature Id="Main" Title="openSCRT" Level="1">
      <ComponentGroupRef Id="HarvestedPayload" />
      <ComponentRef Id="UninstallRegistry" />
    </Feature>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="openSCRT" />
      </Directory>
    </Directory>

  </Product>

  <!-- A Fragment is a sibling of Product, never a child of it (WiX 3 schema), and it is where the
       harvested payload merges in.

       Deliberately absent: an <Environment> element that edits PATH. WiX 3.14 does not accept
       PartPartialPath, the attribute that exists to stop the installer rewriting PATH from its
       1024-character "system" copy, and a truncated machine PATH is a far worse outcome than a
       user adding one directory themselves. The release notes carry that line instead. -->
  <Fragment>
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="UninstallRegistry" Guid="{F5F26896-3F59-49F2-B03B-D7150654C017}">
        <!-- Doubles as the component KeyPath (an <Environment> element cannot be one), and it is
             what gives Add/Remove Programs an uninstall entry and a working install location. -->
        <RegistryValue Root="HKLM"
                       Key="Software\openSCRT"
                       Name="InstallDir"
                       Type="string"
                       Value="[INSTALLFOLDER]"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>