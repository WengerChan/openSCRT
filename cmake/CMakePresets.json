{
  "configurePresets": [
    {
      "name": "linux-ci",
      "displayName": "CI configure (Linux)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "OPENCRT_BUILD_TESTS": "ON",
        "OPENCRT_WARNINGS_AS_ERRORS": "ON",
        "FETCHCONTENT_FULLY_DISCONNECTED": "OFF"
      }
    },
    {
      "name": "windows-ci",
      "displayName": "CI configure (Windows)",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "OPENCRT_BUILD_TESTS": "ON",
        "OPENCRT_WARNINGS_AS_ERRORS": "ON",
        "FETCHCONTENT_FULLY_DISCONNECTED": "OFF"
      }
    },
    {
      "name": "macos-ci",
      "displayName": "CI configure (macOS)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "OPENCRT_BUILD_TESTS": "ON",
        "OPENCRT_WARNINGS_AS_ERRORS": "ON",
        "FETCHCONTENT_FULLY_DISCONNECTED": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-ci",
      "configurePreset": "linux-ci"
    },
    {
      "name": "windows-ci",
      "configurePreset": "windows-ci",
      "configuration": "Release"
    },
    {
      "name": "macos-ci",
      "configurePreset": "macos-ci"
    }
  ],
  "testPresets": [
    {
      "name": "linux-ci",
      "configurePreset": "linux-ci",
      "outputOnFailure": true,
      "timeout": 600,
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-ci",
      "configurePreset": "windows-ci",
      "configuration": "Release",
      "outputOnFailure": true,
      "timeout": 600,
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "macos-ci",
      "configurePreset": "macos-ci",
      "outputOnFailure": true,
      "timeout": 600,
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}